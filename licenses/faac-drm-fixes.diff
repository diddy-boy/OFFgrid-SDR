diff --git a/libfaac/huff2.c b/libfaac/huff2.c
index abc1b2d..56ec5cd 100644
--- a/libfaac/huff2.c
+++ b/libfaac/huff2.c
@@ -321,8 +321,10 @@ static int huffcode(int *qs /* quantized spectrum */,
                     coder->num_data_cw[coder->cur_cw]++;
                     drmbits += blen;
 
-                    if (maxesc < data)
-                        maxesc = data;
+                    /* OFFgrid-SDR fix: VCB11 (table 157) is chosen by the largest absolute value in the section, not
+                       by the escape sequence's coded bit pattern (data), which can be far smaller (16 is coded as 0) */
+                    if (maxesc < abs(qp[0]))
+                        maxesc = abs(qp[0]);
 #endif
                 }
                 bits += blen;
@@ -339,8 +341,8 @@ static int huffcode(int *qs /* quantized spectrum */,
                     coder->num_data_cw[coder->cur_cw]++;
                     drmbits += blen;
 
-                    if (maxesc < data)
-                        maxesc = data;
+                    if (maxesc < abs(qp[1]))                 /* (as above: the value, not its escape pattern) */
+                        maxesc = abs(qp[1]);
 #endif
                 }
                 bits += blen;
